# Azure AI Foundry Configuration
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/
AZURE_AI_MODEL_DEPLOYMENT=gpt-4o

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
AZURE_STORAGE_CONTAINER_NAME=loan-documents

# Azure AI Services (Content Understanding)
# Use your Foundry endpoint - same as AZURE_AI_PROJECT_ENDPOINT
AZURE_AI_SERVICES_ENDPOINT=https://<your-resource>.services.ai.azure.com/

# Local MCP Server Configuration (for development)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Content Understanding MCP Server URL (after deployment to Azure Functions)
CONTENT_UNDERSTANDING_MCP_URL=http://127.0.0.1:8000/mcp

# ---------------------------------------------------------------------------
# MAF Risk Assessment Workflow
# ---------------------------------------------------------------------------
# Microsoft Agent Framework canonical env vars (used by FoundryChatClient).
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/
FOUNDRY_MODEL=gpt-4o

# Optional aliases for the local agent names (purely cosmetic).
INTAKE_AGENT_NAME=loan-processing-json
WEB_SEARCH_AGENT_NAME=web-search-agent
RISK_AGENT_NAME=risk-assessment-agent-aisearch-tool

# Foundry-registered name for the new MAF workflow (distinct from the YAML one).
MAF_WORKFLOW_NAME=maf-risk-assessment-workflow

# OpenTelemetry export to Foundry / Application Insights (optional but
# required for the workflow to show traces in the Foundry portal).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# FastAPI server hosting the workflow (consumed by the React UI).
WORKFLOW_API_HOST=127.0.0.1
WORKFLOW_API_PORT=8001
WORKFLOW_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
